// Prisma schema. The database is Cloudflare D1 (SQLite), reached through
// @prisma/adapter-d1 at runtime. Schema changes go through SQL migrations in
// ./migrations (see "Changing the database schema" in README.md).

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
    runtime  = "cloudflare"
    // Half the size of the default "fast" build; keeps the Worker under the 3 MiB free-plan limit.
    compilerBuild = "small"
}

datasource db {
    provider = "sqlite"
}

model About {
    id        String   @id @default(cuid())
    updatedAt DateTime @updatedAt
    content   String
}

model Image {
    id        String    @id @default(cuid())
    createdAt DateTime  @default(now())
    url       String
    size      Int
    updates   Update[]
    Product   Product[]
}

model Update {
    id         String   @id @default(cuid())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    image      Image    @relation(fields: [imageId], references: [id])
    imageId    String
    title      String
    caption    String
    content    String
    buttonName String
    buttonLink String

    @@index([imageId])
}

model Product {
    id         String   @id @default(cuid())
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
    image      Image    @relation(fields: [imageId], references: [id])
    imageId    String
    title      String
    caption    String

    @@index([imageId])
}

model Review {
    id         String   @id @default(cuid())
    updatedAt  DateTime @updatedAt
    rating     Int
    datePosted DateTime @default(now())
    content    String
    author     String
}
